      "type": "object",
      "default": {
        "desktop": {
          "value": {
            "src": ""
          }
        }
      },
      "settings": {
        "innerContent": {
          "groupType": "group-items",
          "items": {
            "src": {
              "groupSlug": "contentBrand",
              "priority": 8,
              "render": true,
              "subName": "src",
              "attrName": "logoImage.innerContent",
              "label": "Logo navigazione",
              "description": "Carica il logo (SVG, PNG, JPG o WebP). Clicca sul logo nell'header per sostituirlo.",
              "features": {
                "dynamicContent": {
                  "type": "image"
                },
                "sticky": false,
                "preset": "content"
              },
              "component": {
                "name": "divi/upload",
                "type": "field",
                "props": {
                  "syncImageData": {
                    "src": true,
                    "id": true,
                    "alt": false,
                    "titleText": true
                  }
                }
              }
            }
          }
        }
      },
      "selector": "{{selector}} .tp-theme-nav-logo img",
      "elementType": "image",
      "attributes": {
        "class": "tp-theme-nav-logo-img"
