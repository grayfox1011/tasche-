{
  "name": "tp/footer-character",
  "d4Shortcode": "",
  "title": "Personaggio del footer",
  "titles": "Personaggi del footer",
  "moduleIcon": "divi/module-image",
  "moduleClassName": "tp_footer_character",
  "moduleOrderClassName": "tp_footer_character",
  "category": "child-module",
  "parentsName": [
    "tp/theme-footer"
  ],
  "childrenName": [],
  "attributes": {
    "module": {
      "type": "object",
      "selector": "{{selector}}",
      "styleProps": {
        "spacing": {
          "important": true
        }
      },
      "settings": {
        "meta": {
          "meta": {}
        },
        "advanced": {
          "elements": {},
          "html": {},
          "link": {},
          "loop": {}
        },
        "decoration": {
          "layout": {},
          "animation": {},
          "attributes": {},
          "background": {},
          "conditions": {},
          "sizing": {},
          "spacing": {},
          "border": {},
          "boxShadow": {},
          "filters": {},
          "interactions": {},
          "order": {},
          "transform": {},
          "overflow": {},
          "disabledOn": {},
          "transition": {},
          "position": {},
          "scroll": {},
          "zIndex": {},
          "sticky": {}
        }
      }
    },
    "slot": {
      "type": "object",
      "default": {
        "desktop": {
          "value": "three"
        }
      },
      "settings": {
        "innerContent": {
          "groupType": "group-item",
          "item": {
            "groupSlug": "contentMain",
            "attrName": "slot.innerContent",
            "priority": 10,
            "render": true,
            "label": "Posto",
            "description": "Dove sta il personaggio sopra la scritta Tasche Piene. Per spostarlo o cambiarne la misura: Design > Trasforma (Sposta, Scala) o Design > Dimensioni. Per mostrarlo solo su alcuni dispositivi: Avanzate > Visibilità.",
            "features": {
              "sticky": false,
              "responsive": false
            },
            "component": {
              "name": "divi/select",
              "type": "field",
              "props": {
                "options": {
                  "four": {
                    "label": "Dove sta la coppia (sulla «ch» di Tasche)"
                  },
                  "one": {
                    "label": "Dove stanno i piccioni (sulla «ne» di Piene)"
                  },
                  "three": {
                    "label": "Dove sta l'uomo seduto (in fondo a destra)"
                  }
                }
              }
            }
          }
        }
      }
    },
    "image": {
      "type": "object",
      "default": {
        "desktop": {
          "value": {
            "src": "",
            "id": 0
          }
        }
      },
      "settings": {
        "innerContent": {
          "groupType": "group-item",
          "item": {
            "groupSlug": "contentMain",
            "attrName": "image.innerContent",
            "priority": 20,
            "render": true,
            "label": "Immagine",
            "description": "Il disegno del personaggio, meglio con lo sfondo trasparente (PNG, WebP o SVG). Per togliere il personaggio elimina questo elemento (Footer sito > Elementi, icona del cestino).",
            "features": {
              "sticky": false,
              "responsive": false
            },
            "component": {
              "name": "divi/upload",
              "type": "field"
            }
          }
        }
      }
    },
    "flip": {
      "type": "object",
      "default": {
        "desktop": {
          "value": "off"
        }
      },
      "settings": {
        "innerContent": {
          "groupType": "group-item",
          "item": {
            "groupSlug": "contentMain",
            "attrName": "flip.innerContent",
            "priority": 30,
            "render": true,
            "label": "Capovolgi",
            "description": "Gira il personaggio dall'altra parte, come allo specchio.",
            "features": {
              "sticky": false,
              "responsive": false
            },
            "component": {
              "name": "divi/toggle",
              "type": "field",
              "props": {
                "options": {
                  "off": {
                    "label": "No"
                  },
                  "on": {
                    "label": "Sì"
                  }
                }
              }
            }
          }
        }
      }
    },
    "imageUrl": {
      "type": "object",
      "default": {
        "desktop": {
          "value": ""
        }
      },
      "settings": {
        "innerContent": {
          "groupType": "group-item",
          "item": {
            "groupSlug": "contentMain",
            "attrName": "imageUrl.innerContent",
            "priority": 30,
            "render": false,
            "label": "URL fallback (legacy)",
            "features": {
              "dynamicContent": {
                "type": "text"
              },
              "sticky": false,
              "preset": "content"
            },
            "component": {
              "name": "divi/text",
              "type": "field"
            }
          }
        }
      }
    },
    "tpDesignImage": {
      "type": "object",
      "selector": "{{selector}} .tp-theme-footer-character",
      "settings": {
        "decoration": {
          "sizing": {
            "groupType": "group-item",
            "item": {
              "groupSlug": "designTpDesignImage",
              "priority": 10,
              "render": true,
              "component": {
                "name": "divi/sizing",
                "type": "group",
                "props": {
                  "grouped": true,
                  "fieldLabel": "Personaggio"
                }
              }
            }
          },
          "spacing": {
            "groupType": "group-item",
            "item": {
              "groupSlug": "designTpDesignImage",
              "priority": 20,
              "render": true,
              "component": {
                "name": "divi/spacing",
                "type": "group",
                "props": {
                  "grouped": true,
                  "fieldLabel": "Personaggio"
                }
              }
            }
          },
          "border": {
            "groupType": "group-item",
            "item": {
              "groupSlug": "designTpDesignImage",
              "priority": 30,
              "render": true,
              "component": {
                "name": "divi/border",
                "type": "group",
                "props": {
                  "grouped": true,
                  "fieldLabel": "Personaggio"
                }
              }
            }
          },
          "boxShadow": {
            "groupType": "group-item",
            "item": {
              "groupSlug": "designTpDesignImage",
              "priority": 40,
              "render": true,
              "component": {
                "name": "divi/box-shadow",
                "type": "group",
                "props": {
                  "grouped": true,
                  "fieldLabel": "Personaggio"
                }
              }
            }
          },
          "filters": {
            "groupType": "group-item",
            "item": {
              "groupSlug": "designTpDesignImage",
              "priority": 50,
              "render": true,
              "component": {
                "name": "divi/filters",
                "type": "group",
                "props": {
                  "grouped": true,
                  "fieldLabel": "Personaggio"
                }
              }
            }
          }
        }
      },
      "styleProps": {
        "sizing": {
          "important": true
        },
        "spacing": {
          "important": true
        },
        "border": {
          "important": true
        },
        "boxShadow": {
          "important": true
        },
        "filters": {
          "important": true
        }
      }
    }
  },
  "customCssFields": {
    "character": {
      "subName": "character",
      "selectorSuffix": " .tp-theme-footer-character"
    }
  },
  "settings": {
    "content": "auto",
    "design": "auto",
    "advanced": "auto",
    "groups": {
      "contentMain": {
        "panel": "content",
        "priority": 5,
        "groupName": "contentMain",
        "multiElements": true,
        "component": {
          "name": "divi/composite",
          "props": {
            "groupLabel": "Personaggio"
          }
        }
      },
      "designTpDesignImage": {
        "panel": "design",
        "priority": 5,
        "groupName": "designTpDesignImage",
        "component": {
          "name": "divi/composite",
          "props": {
            "groupLabel": "Personaggio"
          }
        }
      }
    }
  }
}
