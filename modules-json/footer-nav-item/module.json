{
  "name": "tp/footer-nav-item",
  "d4Shortcode": "",
  "title": "Footer — Voce menu",
  "titles": "Footer — Voci menu",
  "moduleIcon": "divi/module-menu",
  "moduleClassName": "tp_footer_nav_item",
  "moduleOrderClassName": "tp_footer_nav_item",
  "category": "child-module",
  "childrenName": [],
  "attributes": {
    "module": {
      "type": "object",
      "selector": "{{selector}}",
      "settings": {
        "meta": {
          "meta": {}
        },
        "advanced": {
          "elements": {},
          "html": {},
          "link": {},
          "loop": {}
        },
        "decoration": {
          "layout": {},
          "animation": {},
          "attributes": {},
          "background": {},
          "conditions": {},
          "sizing": {},
          "spacing": {},
          "border": {},
          "boxShadow": {},
          "filters": {},
          "interactions": {},
          "order": {},
          "transform": {},
          "overflow": {},
          "disabledOn": {},
          "transition": {},
          "position": {},
          "scroll": {},
          "zIndex": {},
          "sticky": {}
        }
      }
    },
    "column": {
      "type": "object",
      "default": {
        "desktop": {
          "value": "left"
        }
      },
      "settings": {
        "innerContent": {
          "groupType": "group-item",
          "item": {
            "groupSlug": "contentMain",
            "attrName": "column.innerContent",
            "priority": 10,
            "render": true,
            "label": "Colonna",
            "description": "Scegli se la voce appare nella colonna sinistra o destra del footer.",
            "features": {
              "sticky": false,
              "responsive": false
            },
            "component": {
              "name": "divi/select",
              "type": "field",
              "props": {
                "options": {
                  "left": {
                    "label": "Sinistra"
                  },
                  "right": {
                    "label": "Destra"
                  }
                }
              }
            }
          }
        }
      }
    },
    "text": {
      "type": "object",
      "default": {
        "desktop": {
          "value": "Nuova voce"
        }
      },
      "settings": {
        "innerContent": {
          "groupType": "group-item",
          "item": {
            "groupSlug": "contentMain",
            "attrName": "text.innerContent",
            "priority": 20,
            "render": true,
            "label": "Testo voce",
            "features": {
              "dynamicContent": {
                "type": "text"
              },
              "sticky": false,
              "preset": "content"
            },
            "component": {
              "name": "divi/text",
              "type": "field"
            }
          }
        }
      }
    },
    "link": {
      "type": "object",
      "default": {
        "desktop": {
          "value": "#"
        }
      },
      "settings": {
        "innerContent": {
          "groupType": "group-item",
          "item": {
            "groupSlug": "contentMain",
            "attrName": "link.innerContent",
            "priority": 30,
            "render": true,
            "label": "Link o ancora",
            "features": {
              "dynamicContent": {
                "type": "text"
              },
              "sticky": false,
              "preset": "content"
            },
            "component": {
              "name": "divi/text",
              "type": "field"
            }
          }
        }
      }
    },
    "target": {
      "type": "object",
      "default": {
        "desktop": {
          "value": "off"
        }
      },
      "settings": {
        "innerContent": {
          "groupType": "group-item",
          "item": {
            "groupSlug": "contentMain",
            "attrName": "target.innerContent",
            "priority": 40,
            "render": true,
            "label": "Apri in nuova scheda",
            "features": {
              "sticky": false,
              "responsive": false
            },
            "component": {
              "name": "divi/toggle",
              "type": "field",
              "props": {
                "options": {
                  "off": {
                    "label": "No"
                  },
                  "on": {
                    "label": "Sì"
                  }
                }
              }
            }
          }
        }
      }
    },
    "tpDesignText": {
      "type": "object",
      "selector": "{{selector}} > a, {{selector}} > a *",
      "settings": {
        "decoration": {
          "font": {
            "groupType": "group-item",
            "item": {
              "groupSlug": "designTpDesignText",
              "priority": 10,
              "render": true,
              "component": {
                "name": "divi/font",
                "type": "group",
                "props": {
                  "grouped": false,
                  "fieldLabel": "Voce del menu"
                }
              }
            }
          }
        }
      },
      "styleProps": {
        "font": {
          "important": true
        }
      }
    }
  },
  "customCssFields": {
    "link": {
      "subName": "link",
      "selectorSuffix": " a"
    }
  },
  "settings": {
    "content": "auto",
    "design": "auto",
    "advanced": "auto",
    "groups": {
      "contentMain": {
        "panel": "content",
        "priority": 5,
        "groupName": "contentMain",
        "multiElements": true,
        "component": {
          "name": "divi/composite",
          "props": {
            "groupLabel": "Voce menu"
          }
        }
      },
      "designTpDesignText": {
        "panel": "design",
        "priority": 5,
        "groupName": "designTpDesignText",
        "component": {
          "name": "divi/composite",
          "props": {
            "groupLabel": "Voce del menu"
          }
        }
      }
    }
  }
}
