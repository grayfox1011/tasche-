{
  "name": "tp/header-nav-item",
  "d4Shortcode": "",
  "title": "Voce del menu",
  "titles": "Voci del menu",
  "moduleIcon": "divi/module-menu",
  "moduleClassName": "tp_header_nav_item",
  "moduleOrderClassName": "tp_header_nav_item",
  "category": "child-module",
  "parentsName": ["tp/theme-header"],
  "childrenName": [],
  "attributes": {
    "module": {
      "type": "object",
      "selector": "{{selector}}",
      "settings": {
        "meta": {
          "meta": {}
        },
        "advanced": {},
        "decoration": {}
      }
    },
    "text": {
      "type": "object",
      "default": {
        "desktop": {
          "value": "Nuova voce"
        }
      },
      "settings": {
        "innerContent": {
          "groupType": "group-item",
          "item": {
            "groupSlug": "contentMain",
            "attrName": "text.innerContent",
            "priority": 10,
            "render": true,
            "label": "Testo",
            "description": "La scritta della voce nel menu in alto (anche nel menu del telefono).",
            "features": {
              "sticky": false,
              "responsive": false,
              "preset": "content"
            },
            "component": {
              "name": "divi/text",
              "type": "field"
            }
          }
        }
      }
    },
    "link": {
      "type": "object",
      "default": {
        "desktop": {
          "value": "#home"
        }
      },
      "settings": {
        "innerContent": {
          "groupType": "group-item",
          "item": {
            "groupSlug": "contentMain",
            "attrName": "link.innerContent",
            "priority": 20,
            "render": true,
            "label": "Link o ancora",
            "description": "Una sezione della home (#home, #chi-siamo, #menu, #materie, #location, #orari) oppure un indirizzo https://...",
            "features": {
              "sticky": false,
              "responsive": false,
              "preset": "content"
            },
            "component": {
              "name": "divi/text",
              "type": "field"
            }
          }
        }
      }
    },
    "target": {
      "type": "object",
      "default": {
        "desktop": {
          "value": "off"
        }
      },
      "settings": {
        "innerContent": {
          "groupType": "group-item",
          "item": {
            "groupSlug": "contentMain",
            "attrName": "target.innerContent",
            "priority": 30,
            "render": true,
            "label": "Apri in una nuova scheda",
            "features": {
              "sticky": false,
              "responsive": false
            },
            "component": {
              "name": "divi/toggle",
              "type": "field",
              "props": {
                "options": {
                  "off": {
                    "label": "No"
                  },
                  "on": {
                    "label": "Sì"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "customCssFields": {},
  "settings": {
    "content": "auto",
    "design": "auto",
    "advanced": "auto",
    "groups": {
      "contentMain": {
        "panel": "content",
        "priority": 5,
        "groupName": "contentMain",
        "multiElements": true,
        "component": {
          "name": "divi/composite",
          "props": {
            "groupLabel": "Voce del menu"
          }
        }
      }
    }
  }
}
